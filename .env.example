# --- Database ---
DATABASE_URL=postgresql+asyncpg://aisw:aisw@localhost:5432/aisw

# --- Self-hosted LLM server (OpenAI-compatible: vLLM / SGLang) ---
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=your-model-name
LLM_API_KEY=not-needed

# --- Local embedding model (sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Guardrail thresholds (also editable via admin UI, stored in `domains` table) ---
SCOPE_THRESHOLD=0.35
RETRIEVAL_THRESHOLD=0.475

# --- Admin auth ---
ADMIN_JWT_SECRET=change-me-to-a-random-secret
ADMIN_JWT_EXPIRE_MINUTES=720

# --- Anonymous client session cookie ---
SESSION_COOKIE_NAME=aisw_sid
SESSION_COOKIE_SECURE=false

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
